{
  "description": "Design tokens shared by every front end (NiceGUI and React). Colours meet WCAG AA (4.5:1) for text on their backgrounds in both themes. Change a colour here, never in a page.",
  "font": {"family": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif", "mono": "'JetBrains Mono', ui-monospace, monospace"},
  "radius": {"card": "10px", "control": "6px", "badge": "999px"},
  "space": {"page_x": "24px", "page_x_mobile": "16px", "gap": "16px", "max_width": "1480px"},
  "breakpoints": {"mobile": 600, "tablet": 1024},
  "light": {
    "primary": "#1F3A5F", "on_primary": "#FFFFFF", "accent": "#2F6FB2",
    "background": "#FFFFFF", "surface": "#F3F5F8", "surface_raised": "#FFFFFF", "border": "#D9DEE5",
    "text": "#1B2430", "text_muted": "#4B5563",
    "success": "#0F6E2E", "success_bg": "#E6F4EA", "warning": "#8A5A00", "warning_bg": "#FFF4DB",
    "danger": "#B42318", "danger_bg": "#FDECEA", "info": "#1F5A96", "info_bg": "#E8F1FB",
    "neutral": "#4B5563", "neutral_bg": "#EEF0F3", "focus": "#1F3A5F",
    "heat_0": "#EEF4FB", "heat_1": "#C9DCF2", "heat_2": "#8FB5E3", "heat_3": "#4F86C6", "heat_4": "#1F3A5F"
  },
  "dark": {
    "primary": "#8FB3E0", "on_primary": "#0F141B", "accent": "#6FA3DC",
    "background": "#0F141B", "surface": "#18202B", "surface_raised": "#1E2834", "border": "#2E3A48",
    "text": "#E6EBF2", "text_muted": "#A3ADBB",
    "success": "#6FD69A", "success_bg": "#123222", "warning": "#F0B44C", "warning_bg": "#3A2C0F",
    "danger": "#FF8A80", "danger_bg": "#3D1614", "info": "#8FB3E0", "info_bg": "#16263A",
    "neutral": "#A3ADBB", "neutral_bg": "#232D39", "focus": "#8FB3E0",
    "heat_0": "#16263A", "heat_1": "#1E3A5C", "heat_2": "#2F5A8C", "heat_3": "#4F86C6", "heat_4": "#8FB3E0"
  },
  "verdict": {"GO": "success", "CONDITIONAL GO": "warning", "NO-GO": "danger", "ANALYSIS INCOMPLETE": "neutral"},
  "rag": {"Green": "success", "Yellow": "warning", "Red": "danger"},
  "environment": {"DEV": "neutral", "TEST": "warning", "PROD": "danger"},
  "chart_dark": {
    "description": "Chart colours of the API's Plotly figures (made for a light page) that are hard to read on the dark theme, and what the front ends draw instead in dark mode. Light mode draws the figures unchanged.",
    "colours": {"#1F3A5F": "#8FB3E0", "#1F1F1D": "#E6EBF2", "#B42318": "#FF8A80", "#FFFFFF": "#1E2834", "rgba(252,252,251,0.9)": "rgba(30,40,52,0.9)"}
  }
}
