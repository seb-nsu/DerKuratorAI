ENVIRONMENT=DEV
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-...
GOOGLE_API_KEY=AIza...
ORCHESTRATOR_MODEL=gpt-4o-mini
ANALYST_MODEL=claude-sonnet-5
SIMULATOR_MODEL=gpt-4o
ADVISORY_MODEL=claude-sonnet-5
DATA_SOURCE=json

# --- Optional (Defaults in app/core/config.py) ---
# JSON_PATH=data/DerKurator_Demo_Portfolio.json
# EXCEL_PATH=data/DerKurator_Demo_Portfolio.xlsx
# DATA_SOURCE=mapped reads any structure through a mapping file (docs/DATA_MAPPING.md)
# MAPPING_FILE=data/mappings/servicenow_demo.yaml
# DATA_SOURCE=servicenow reads the ServiceNow Table API into a local snapshot (docs/DATA_MAPPING.md › ServiceNow)
# SERVICENOW_MAPPING_FILE=data/mappings/servicenow_spm.yaml
# SERVICENOW_INSTANCE=https://<name>.service-now.com
# SERVICENOW_USER=
# SERVICENOW_PASSWORD=
# SERVICENOW_TOKEN=            # instead of user and password: OAuth bearer token
# SERVICENOW_RECONCILE_HOURS=24 # check for records deleted in ServiceNow at most this often (0 = every sync)
# Optional OpenTelemetry export (spans + metrics, no prompt or answer text) to the company's collector:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer <token>
# FORCE_OFFLINE_MODE=false
# Dependency graph: NetworkX in memory (default) or additionally projected into Neo4j 5.21+ (docs/PILOT_OPERATIONS.md)
# GRAPH_BACKEND=networkx
# NEO4J_URI=neo4j+s://graph.example.com:7687
# NEO4J_USER=derkurator
# NEO4J_PASSWORD=        # secret: only here or in the host's secrets
# NEO4J_DATABASE=neo4j   # a database of its own is preferred, e.g. derkurator
# AUTH_USERS_FILE=path/to/users.json   # required in PROD; DEV/TEST default: data/demo_users.json
# AUTH_EXTRA_USERS=path/to/admin.json  # optional real accounts (e.g. your admin) merged with the user file
# AUTH_ADMIN_PASSWORD=   # simplest admin access: sign in as ADMIN with this password (min. 12 characters, never committed)
# AUTH_ADMIN_USER=ADMIN  # optional other user id for that admin account
# API_TOKEN_SECRET=      # HTTP API (uvicorn app.api.main:app): token signing secret, min. 32 characters; required in PROD
# NICEGUI_STORAGE_SECRET= # NiceGUI front end: signs the session cookie, min. 32 characters; required in PROD
# NICEGUI_STORAGE_PATH=   # NiceGUI sessions (hold API tokens); default data/nicegui (or DERKURATOR_WRITE_DIR/nicegui)
# Notifications by mail or Microsoft Teams about the approval inbox (off by default; docs/PILOT_OPERATIONS.md):
# NOTIFY_ENABLED=false
# NOTIFY_SMTP_HOST=smtp.example.com
# NOTIFY_SMTP_PORT=587
# NOTIFY_SMTP_STARTTLS=true
# NOTIFY_SMTP_USER=
# NOTIFY_SMTP_PASSWORD=   # secret
# NOTIFY_SMTP_FROM=derkurator@example.com
# NOTIFY_PMO_TO=pmo@example.com            # role mailboxes, comma-separated (accounts may carry their own "email")
# NOTIFY_BOARD_TO=board@example.com
# NOTIFY_TEAMS_PMO_URL=    # Teams incoming webhook / Power Automate workflow URL – secret
# NOTIFY_TEAMS_BOARD_URL=  # secret
# APP_BASE_URL=https://kurator.example.com   # links in the messages
