# Public Docker demo (docker-compose.demo.yml). Copy to .env.demo (never committed) and fill in.
# No API keys here: the demo runs offline, so visitors cause no LLM costs.

# Domain of the demo; its DNS A/AAAA record points at this host (ports 80 and 443 open). localhost for a local test.
DEMO_DOMAIN=kurator-demo.example.com

# Front end: streamlit (today's product) | nicegui | react
FRONTEND=streamlit

# Optional: your own admin account (user ADMIN, min. 12 characters) – the demo accounts have no Admin Console access
AUTH_ADMIN_PASSWORD=
