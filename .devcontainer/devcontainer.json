{
  "name": "DerKurator AI (Python 3.14)",
  "image": "mcr.microsoft.com/devcontainers/python:3-3.14-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "scripts/serve.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "containerEnv": {
    "ENVIRONMENT": "TEST",
    "FORCE_OFFLINE_MODE": "true"
  },
  "updateContentCommand": "[ -f packages.txt ] && sudo apt update && sudo apt upgrade -y && sudo xargs apt install -y <packages.txt; pip3 install --user -r requirements.txt && echo 'Requirements installed'",
  "postAttachCommand": {
    "server": "FRONTEND=nicegui python3 scripts/serve.py"
  },
  "portsAttributes": {
    "8080": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8080
  ]
}
